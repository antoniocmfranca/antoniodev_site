<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A. Carlos Maia F. | Portfólio</title>
    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap"
      rel="stylesheet"
    />
    <!-- FontAwesome para Ícones -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      /* Variáveis de Cores (Tema Dark Premium) */
      :root {
        --bg-color: #0f172a;
        --text-color: #f8fafc;
        --primary-color: #3b82f6;
        --secondary-color: #1e293b;
        --accent-color: #60a5fa;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Inter", sans-serif;
        scroll-behavior: smooth;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        line-height: 1.6;
      }

      /* Navbar */
      header {
        position: fixed;
        top: 0;
        width: 100%;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(10px);
        padding: 20px 10%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
        border-bottom: 1px solid var(--secondary-color);
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-color);
        text-decoration: none;
      }

      .logo span {
        color: var(--primary-color);
      }

      nav ul {
        display: flex;
        list-style: none;
        gap: 30px;
      }

      nav ul li a {
        color: var(--text-color);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
      }

      nav ul li a:hover {
        color: var(--accent-color);
      }

      /* Seções Gerais */
      section {
        padding: 100px 10%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .section-title {
        font-size: 2.5rem;
        margin-bottom: 40px;
        text-align: center;
        color: var(--primary-color);
      }

      /* Hero Section (Início) */
      #inicio {
        align-items: flex-start;
      }

      .hero-content h1 {
        font-size: 4rem;
        line-height: 1.1;
        margin-bottom: 20px;
      }

      .hero-content h2 {
        font-size: 2rem;
        font-weight: 400;
        color: var(--accent-color);
        margin-bottom: 20px;
      }

      .hero-content p {
        max-width: 600px;
        font-size: 1.1rem;
        margin-bottom: 30px;
        color: #cbd5e1;
      }

      .btn {
        display: inline-block;
        padding: 15px 30px;
        background-color: var(--primary-color);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        transition:
          background 0.3s ease,
          transform 0.2s;
      }

      .btn:hover {
        background-color: var(--accent-color);
        transform: translateY(-3px);
      }

      /* Sobre Mim Styling Premium */
      .about-container {
        max-width: 850px;
        margin: 0 auto;
        background: var(--secondary-color);
        padding: 40px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      .about-subtitle {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent-color);
        margin-bottom: 25px;
        text-align: center;
        line-height: 1.3;
      }

      .about-text p {
        font-size: 1.05rem;
        color: #cbd5e1;
        margin-bottom: 18px;
        text-align: justify;
        line-height: 1.7;
      }

      .about-text p:last-child {
        margin-bottom: 0;
      }

      /* Tech Skills Grid */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        text-align: center;
      }

      .skill-card {
        background-color: var(--secondary-color);
        padding: 30px 20px;
        border-radius: 12px;
        transition: transform 0.3s ease;
        border: 1px solid transparent;
      }

      .skill-card:hover {
        transform: translateY(-10px);
        border-color: var(--primary-color);
      }

      .skill-card i {
        font-size: 3rem;
        color: var(--accent-color);
        margin-bottom: 15px;
      }

      .skill-card h3 {
        font-size: 1.2rem;
      }

      /* Experiência e Formação */
      .timeline {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
      }

      .timeline-item {
        background: var(--secondary-color);
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 20px;
        border-left: 5px solid var(--primary-color);
      }

      .timeline-item h3 {
        margin-bottom: 10px;
        color: var(--accent-color);
      }

      .timeline-item span {
        font-size: 0.9rem;
        color: #94a3b8;
        display: block;
        margin-bottom: 15px;
      }

      /* Contato */
      .contact-info {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 30px;
      }

      .contact-item {
        text-align: center;
        font-size: 1.2rem;
      }

      .contact-item a {
        color: var(--text-color);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .contact-item a:hover {
        color: var(--accent-color);
      }

      .contact-item i {
        display: block;
        font-size: 2rem;
        margin-bottom: 10px;
        color: var(--primary-color);
      }

      /* Footer */
      footer {
        text-align: center;
        padding: 20px;
        background-color: var(--secondary-color);
        font-size: 0.9rem;
      }

      /* Responsividade */
      @media (max-width: 768px) {
        nav ul {
          display: none;
        }
        .hero-content h1 {
          font-size: 2.5rem;
        }
        .hero-content h2 {
          font-size: 1.5rem;
        }
        .contact-info {
          flex-direction: column;
          gap: 20px;
        }
        .about-container {
          padding: 25px;
        }
        .about-subtitle {
          font-size: 1.25rem;
        }
      }
    </style>
  </head>
